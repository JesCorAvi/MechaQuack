# =========================================================================
# Unity .gitignore - Pato-Mecha 3000
# =========================================================================

# Unity generated folders
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# Asset store tools
[Aa]ssets/AssetStoreTools*

# Autogenerated IDE solutions and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity profiler and crash artifacts
sysinfo.txt
*.stackdump
crash.dmp
crashpad_handler.exe

# Unity Code Coverage
[Cc]apture[Rr]ecordings/
[Cc]ode[Cc]overage/

# Unity Plastic SCM & Version Control temp files
.plastic/
.collab/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
[Tt]humbs.db
[Dd]esktop.ini

# IDE & Editor caches
.vs/
.idea/
.vscode/
*.swp
*.swo
*~

# Builds and executables
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.dll

# Gradle cache
.gradle/

# Never ignore meta files for tracked assets
!*.meta
